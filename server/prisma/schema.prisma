generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferences   UserPreferences?
  buckets       Bucket[]
  goals         Goal[]
  tasks         Task[]
  taskEvents    TaskEvent[]
  conversations AssistantConversation[]
  lessons       BucketLesson[]
  memories      PersonalMemory[]
  liveSessions  LiveSession[]
  liveUsages    LiveUsage[]
}

model AssistantConversation {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "quick" is the older Talk capture. "conversation" is the live assistant.
  mode          String             @default("quick")
  personalityId String             @default("puck")
  title         String?
  summary       String?
  endedAt       DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  messages      AssistantMessage[]
  summaryRow    ConversationSummary?
  liveSessions  LiveSession[]

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  /// Structured record of what the assistant did (or asked) for this turn.
  actions        Json?
  /// "text" or "voice".
  channel        String               @default("text")
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

model UserPreferences {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone      String   @default("UTC")
  weekStartsOn  Int      @default(0)
  personalityId String   @default("puck")
  /// task, both, or chat. Task is the short objective default.
  assistantFocus String  @default("task")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Bucket {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  color      String?
  icon       String?
  sortOrder  Int       @default(0)
  /// Home bucket. One per user. Rename is allowed. Archive is refused.
  isDefault  Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tasks   Task[]
  lessons BucketLesson[]

  @@index([userId])
}

/// A task title the user placed by hand, and the bucket they chose.
model BucketLesson {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phrase    String
  bucketId  String
  bucket    Bucket   @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phrase])
  @@index([userId, updatedAt])
}

enum GoalStatus {
  active
  completed
  archived
}

model Goal {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      GoalStatus @default(active)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tasks Task[]

  @@index([userId])
}

enum TaskOrigin {
  manual
  assistant
  import
}

enum TaskStatus {
  captured
  active
  completed
  dropped
}

enum Confidence {
  low
  medium
  high
}

enum DeadlineSource {
  explicit
  inferred
}

enum Importance {
  low
  medium
  high
}

enum Effort {
  low
  medium
  high
}

model RecurrenceRule {
  id         String    @id @default(uuid())
  frequency  String // "daily" | "weekly" | "monthly"
  interval   Int       @default(1)
  byWeekday  Int[]     @default([])
  byMonthday Int?
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tasks Task[]
}

model Task {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucketId           String?
  bucket             Bucket?         @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  goalId             String?
  goal               Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title              String
  notes              String?
  origin             TaskOrigin      @default(manual)
  status             TaskStatus      @default(captured)
  attentionDate      DateTime?
  plannedWindowStart DateTime?
  plannedWindowEnd   DateTime?
  hardDeadline       DateTime?
  deadlineSource     DeadlineSource?
  estimateMinutes    Int?
  estimateConfidence Confidence?
  actualMinutes      Int?
  importance         Importance      @default(medium)
  /// How big the work is. Optional. Does not move the task between lists.
  effort             Effort?
  waitingOn          String?
  recurrenceRuleId   String?
  recurrenceRule     RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  snoozedUntil       DateTime?
  completedAt        DateTime?
  droppedAt          DateTime?
  archivedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  occurrences TaskOccurrence[]
  events      TaskEvent[]

  @@index([userId, status])
  @@index([userId, bucketId])
  @@index([userId, attentionDate])
}

enum OccurrenceStatus {
  pending
  completed
  skipped
}

model TaskOccurrence {
  id             String           @id @default(uuid())
  taskId         String
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime         @db.Date
  status         OccurrenceStatus @default(pending)
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([taskId, occurrenceDate])
}

enum TaskEventType {
  created
  updated
  completed
  uncompleted
  snoozed
  dropped
  reopened
  archived
}

model TaskEvent {
  id        String        @id @default(uuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TaskEventType
  payload   Json?
  createdAt DateTime      @default(now())

  @@index([taskId, createdAt])
}

model ConversationSummary {
  id             String                @id @default(uuid())
  conversationId String                @unique
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  decisions      String                @default("")
  unresolved     String                @default("")
  commitments    String                @default("")
  carryForward   String                @default("")
  modelId        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model PersonalMemory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  text      String
  source    String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model LiveSession {
  id                String                @id @default(uuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerSessionId String                @unique
  personalityId     String
  status            String                @default("open")
  changeSeq         Int                   @default(0)
  createdAt         DateTime              @default(now())
  closedAt          DateTime?
  usage             LiveUsage?

  @@index([userId, createdAt])
}

model LiveUsage {
  id                  String      @id @default(uuid())
  liveSessionId       String      @unique
  liveSession         LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  seconds             Int         @default(0)
  activeSeconds       Int         @default(0)
  pausedSeconds       Int         @default(0)
  backendInputTokens  Int         @default(0)
  backendOutputTokens Int         @default(0)
  estimatedUsd        Float       @default(0)
  finalized           Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([userId, createdAt])
}
