DATABASE_URL="postgresql://taskr:taskr_dev_password@localhost:5433/taskr_dev"
SESSION_SECRET="change-me-to-a-long-random-string"
PORT=4100

# Product name. Personalities are the assistant names.
APP_NAME="Taskr"

# Optional. Quick capture, Talk speech, and the GPT-Live conversation use this.
# Leave unset to run quick capture with no external calls. Live voice then
# refuses to start, and a typed live turn does not create tasks.
OPENAI_API_KEY=
